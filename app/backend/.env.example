PORT=3000

# ─── Supabase REST API (catalogue produits, recommandations) ──────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ─── PostgreSQL Direct (Drizzle ORM — orders, users, wallet, disputes) ────────
# Transaction pooler port 6543 (recommandé Node.js) ou Session pooler port 5432
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# ─── Sendit ───────────────────────────────────────────────────────────────────
SENDIT_SIMULATION=true
# SENDIT_API_TOKEN=your_production_token

# ─── Sécurité Auth Custom ─────────────────────────────────────────────────────
JWT_SECRET=your_secure_jwt_secret
ADMIN_MASTER_KEY=your_admin_master_passkey
SENDIT_SECRET_KEY=your_sendit_webhook_secret_key
