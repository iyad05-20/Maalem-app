# ─── Serveur Backend ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Supabase REST API & Auth ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# ─── PostgreSQL Direct (Drizzle ORM & Postgres.js) ──────────────────────────
# Transaction pooler port 6543 (Recommandé en mode serverless / transaction)
# Session pooler port 5432
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres"

# ─── Cloudflare Workers AI (Llama 3.1 & FLUX.1 pour l'Atelier) ──────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ─── Moteur de Recherche Meilisearch ─────────────────────────────────────────
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=your_meilisearch_master_key

# ─── Transport & Logistique Sendit ──────────────────────────────────────────
# true = mode simulation sandbox, false = appel API Sendit direct en production
SENDIT_SIMULATION=true
# SENDIT_API_TOKEN=your_production_sendit_token
# SENDIT_SECRET_KEY=your_sendit_webhook_secret_key

# ─── Sécurité Auth Custom & Tokens ──────────────────────────────────────────
JWT_SECRET=your_secure_jwt_secret_min_32_characters
ADMIN_MASTER_KEY=your_admin_master_passkey

